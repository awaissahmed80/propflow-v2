APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://propflow.test
APP_BASE_DOMAIN=propflow.test
APP_URL_SCHEME=https

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

LARAVEL_PDF_DRIVER=dompdf

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.propflow.test
SESSION_CONNECTION=landlord

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=portal.propflow.test
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
DB_CACHE_CONNECTION=landlord
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Meta / Facebook platform app (Facebook Login for Business)
# Add this exact redirect URI in Meta → App → Facebook Login → Settings
# (leave META_REDIRECT_URI blank to use the portal default callback).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_VERSION=v21.0
META_SCOPES=pages_show_list,pages_manage_ads,pages_manage_metadata,pages_read_engagement,leads_retrieval,ads_management,pages_messaging,instagram_basic,instagram_manage_messages,business_management
META_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Business Cloud API (defaults to Meta app credentials when blank)
# Tenants connect their own WABA; Meta bills the account holder for messaging.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_REDIRECT_URI=
WHATSAPP_GRAPH_VERSION=
# WhatsApp-only — do NOT copy META_SCOPES here (no pages_*/instagram_*/leads_*).
WHATSAPP_SCOPES=whatsapp_business_management,whatsapp_business_messaging,business_management
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional: Login for Business config that includes ONLY WhatsApp permissions.
# Do not reuse a Meta Lead Ads / Pages configuration ID.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

