{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",    
    "paths": {
      "@/*": ["./resources/js/*"],
      "@/portal/*": ["./resources/js/apps/portal/*"]
    }
  },
  "include": [
    "resources/js/**/*.jsx",
    "resources/js/**/*.js"
  ]
}